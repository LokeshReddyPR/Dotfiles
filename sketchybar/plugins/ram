#!/usr/bin/env bash

source "$CONFIG_DIR/themes/tokyonight"

# Memory Used %, matching macOS Activity Monitor's "Memory Used":
#   Available   = (Free + File-backed - Speculative) pages
#   Memory Used = Physical - Available            (== App + Wired + Compressed)
# Cached Files are intentionally NOT counted as used.
PAGESIZE="$(sysctl -n hw.pagesize)"
MEMSIZE="$(sysctl -n hw.memsize)"

USED="$(vm_stat | awk -F: -v ps="$PAGESIZE" -v total="$MEMSIZE" '
  /Pages free/        { gsub(/[^0-9]/,"",$2); free=$2 }
  /Pages speculative/ { gsub(/[^0-9]/,"",$2); spec=$2 }
  /File-backed pages/ { gsub(/[^0-9]/,"",$2); ext=$2 }
  END {
    avail = (free + ext - spec) * ps
    printf "%.0f", (total - avail) * 100 / total
  }')"

if [ -z "$USED" ]; then
  exit 0
fi

# Higher utilization = worse: blue -> yellow -> red.
# NOTE: on macOS this legitimately sits high (85-90% is normal) because the OS
# keeps RAM full via compression; tune these cutoffs to taste.
if [ "$USED" -ge 90 ]; then
  COLOR="$red"
elif [ "$USED" -ge 75 ]; then
  COLOR="$yellow"
else
  COLOR="$blue"
fi

sketchybar --set "$NAME" label="${USED}%" icon.color="$COLOR" label.color="$COLOR" \
           --set "${NAME}_bracket" background.border_color="$COLOR"

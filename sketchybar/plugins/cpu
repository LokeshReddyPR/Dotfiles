#!/usr/bin/env bash

source "$CONFIG_DIR/themes/tokyonight"

# Grab the second CPU sample from top (the first is since-boot and useless),
# pull the "idle" percentage, and report usage = 100 - idle.
IDLE="$(top -l 2 -n 0 | grep -E "^CPU usage" | tail -1 \
        | awk -F'[, ]+' '{ for (i = 1; i <= NF; i++) if ($i == "idle") print $(i - 1) }' \
        | tr -d '%')"

if [ -z "$IDLE" ]; then
  exit 0
fi

USAGE="$(printf "%.0f" "$(echo "100 - $IDLE" | bc -l)")"

# Higher utilization = worse: blue -> yellow -> red.
if [ "$USAGE" -ge 80 ]; then
  COLOR="$red"
elif [ "$USAGE" -ge 50 ]; then
  COLOR="$yellow"
else
  COLOR="$blue"
fi

sketchybar --set "$NAME" label="${USAGE}%" icon.color="$COLOR" label.color="$COLOR" \
           --set "${NAME}_bracket" background.border_color="$COLOR"

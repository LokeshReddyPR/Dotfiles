# Font Style and Size
font-family = "MesloLGS Nerd Font Mono"
font-size = 25

# Fixed Window Size on Opening (Columns x Rows)
# Adjust these numbers to make the startup window larger or smaller
window-width = 100
window-height = 25

# Background Effects to match WezTerm
background-opacity = 0.8
background-blur = true


# --- Custom Cursor Shader Animations ---
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = always

# This hides the top bar entirely but lets you drag the window from anywhere!
macos-titlebar-style = hidden

theme = Gruvbox Dark
